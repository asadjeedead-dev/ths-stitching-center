rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /applications/{id} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    match /activity/{id} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    match /inquiries/{id} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    match /students/{id} {
      allow read, write: if isSignedIn();
    }

    match /orders/{id} {
      allow read, write: if isSignedIn();
    }

    match /attendance/{id} {
      allow read, write: if isSignedIn();
    }

    match /admins/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
